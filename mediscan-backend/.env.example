# ============================================
# MediScan AI Backend - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================

# ---------- Server ----------
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ---------- MongoDB ----------
# Local:   mongodb://localhost:27017/mediscan
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mediscan
MONGODB_URI=mongodb://localhost:27017/mediscan

# ---------- JWT ----------
# Use a long, random, secret string (32+ characters). Never reuse across environments.
JWT_SECRET=replace-this-with-a-long-random-secret-string
JWT_EXPIRATION=86400000

# ---------- AI / LLM Service ----------
# Example uses the Anthropic Messages API; swap for your provider if different.
AI_API_KEY=your-ai-api-key-here
AI_API_URL=https://api.anthropic.com/v1/messages
AI_API_MODEL=claude-sonnet-4-6
AI_API_TIMEOUT_MS=30000

# ---------- OCR (Tesseract) ----------
# Path to the directory CONTAINING the "tessdata" folder (not the tesseract binary).
# Linux example:   /usr/share/tesseract-ocr/5/
# macOS (brew):    /opt/homebrew/share/tessdata/
# Windows example: C:/Program Files/Tesseract-OCR/tessdata
TESSERACT_PATH=
TESSERACT_LANGUAGE=eng

# ---------- File Upload ----------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=12MB

# ---------- CORS ----------
# Comma-separated list. Include your Flutter dev origin(s) and/or laptop LAN IP if relevant.
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.100:8080

# ---------- Logging ----------
LOG_LEVEL=INFO
